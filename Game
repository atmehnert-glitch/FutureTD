<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Future TD</title>
    <style>
        * { box-sizing: border-box; user-select: none; margin: 0; padding: 0; }
        body { background: #121214; color: #fff; font-family: system-ui, sans-serif; display: flex; flex-direction: column; align-items: center; min-height: 100vh; overflow: hidden; padding: 10px; }
        #app-container { display: flex; flex-direction: column; background: #1a1a1e; border: 2px solid #2d2d34; border-radius: 12px; padding: 12px; width: 100%; max-width: 450px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        h1 { text-align: center; font-size: 20px; color: #ffd700; margin-bottom: 8px; letter-spacing: 1px; }
        #hud { display: flex; justify-content: space-between; margin-bottom: 10px; padding: 8px; background: #26262b; border-radius: 6px; font-weight: bold; font-size: 13px; border: 1px solid #36363f; }
        .stat span { color: #ffd700; }
        .stat.hp span { color: #ff4d4d; }
        #canvas-wrapper { position: relative; background: #151518; border: 2px solid #36363f; border-radius: 8px; overflow: hidden; width: 100%; aspect-ratio: 4/3; }
        canvas { display: block; width: 100%; height: 100%; }
        #controls { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
        .shop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
        .btn { background: #2d2d34; border: 1px solid #4a4a55; color: #fff; padding: 10px 4px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 11px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .btn:active:not(:disabled) { background: #3a3a44; border-color: #ffd700; }
        .btn:disabled { opacity: 0.3; }
        .btn .cost { font-size: 9px; color: #ffd700; margin-top: 1px; }
        .btn.active { background: #ffd700; color: #000; border-color: #fff; }
        .btn.active .cost { color: #320; }
        #inspect-panel { display: none; background: #222227; border: 1px solid #36363f; border-radius: 8px; padding: 8px; flex-direction: column; gap: 4px; }
        .inspect-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 4px; }
        .btn-upgrade { background: #1e3a1e; border-color: #2e5a2e; }
        .btn-sell { background: #3a1e1e; border-color: #5a2e2e; }
        #wave-btn { width: 100%; background: #ffd700; color: #000; font-weight: bold; font-size: 14px; padding: 12px; margin-top: 4px; }
    </style>
</head>
<body>

<div id="app-container">
    <h1>FUTURE TD</h1>
    <div id="hud">
        <div class="stat hp">❤️ Lives: <span id="hp-val">20</span></div>
        <div class="stat">💰 Gold: <span id="gold-val">300</span></div>
        <div class="stat">🛡️ Wave: <span id="wave-val">0</span></div>
    </div>

    <div id="canvas-wrapper">
        <canvas id="gameCanvas" width="400" height="300"></canvas>
    </div>

    <div id="controls">
        <div class="shop-grid" id="shop-container"></div>

        <div id="inspect-panel">
            <div id="inspect-stats" style="font-size:11px; color:#a1a1aa; text-align:center;"></div>
            <div class="inspect-actions">
                <button class="btn btn-upgrade" id="upgrade-btn">Upgrade<div class="cost" id="upgrade-cost">-$0</div></button>
                <button class="btn btn-sell" id="sell-btn">Sell<div class="cost" id="sell-refund">+$0</div></button>
            </div>
        </div>

        <button class="btn" id="wave-btn">LAUNCH NEXT WAVE</button>
    </div>
</div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    const TILE_SIZE = 25;
    const COLS = 16;
    const ROWS = 12;

    let gold = 300, lives = 20, wave = 0, waveActive = false;
    let selectedShopType = null, selectedTower = null;
    let towers = [], enemies = [], projectiles = [];

    const gridPath = [
        {x:0,y:2},{x:1,y:2},{x:2,y:2},{x:3,y:2},{x:3,y:8},{x:4,y:8},{x:5,y:8},
        {x:6,y:8},{x:6,y:3},{x:7,y:3},{x:8,y:3},{x:9,y:3},{x:9,y:7},{x:10,y:7},
        {x:11,y:7},{x:12,y:7},{x:12,y:4},{x:13,y:4},{x:14,y:4},{x:15,y:4}
    ];

    const TOWER_TYPES = {
        gun: { name: "Gunner", cost: 100, range: 70, damage: 15, fireRate: 25, color: "#4ade80" },
        cannon: { name: "Cannon", cost: 125, range: 60, damage: 40, fireRate: 50, color: "#f87171" },
        tesla: { name: "Tesla", cost: 150, range: 65, damage: 12, fireRate: 20, color: "#a78bfa", type: "tesla" },
        laser: { name: "Laser", cost: 175, range: 80, damage: 2, fireRate: 2, color: "#fb923c", type: "laser" }
    };

    function initUI() {
        const container = document.getElementById('shop-container');
        container.innerHTML = '';
        Object.keys(TOWER_TYPES).forEach(key => {
            const t = TOWER_TYPES[key];
            const btn = document.createElement('button');
            btn.className = 'btn';
            btn.id = `shop-${key}`;
            btn.innerHTML = `🏗️ ${t.name}<span class="cost">💰${t.cost}</span>`;
            btn.onclick = () => selectShopItem(key);
            container.appendChild(btn);
        });
        updateHUD();
    }

    function updateHUD() {
        document.getElementById('gold-val').innerText = gold;
        document.getElementById('hp-val').innerText = lives;
        document.getElementById('wave-val').innerText = wave;
        Object.keys(TOWER_TYPES).forEach(key => {
            const btn = document.getElementById(`shop-${key}`);
            if(btn) btn.disabled = gold < TOWER_TYPES[key].cost;
        });
        if (selectedTower) inspectUnit(selectedTower);
    }

    function selectShopItem(type) {
        selectedTower = null;
        document.getElementById('inspect-panel').style.display = 'none';
        Object.keys(TOWER_TYPES).forEach(k => document.getElementById(`shop-${k}`).classList.remove('active'));
        if (selectedShopType === type) { selectedShopType = null; } 
        else { selectedShopType = type; document.getElementById(`shop-${type}`).classList.add('active'); }
    }

    canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        const clickX = ((touch.clientX - rect.left) / rect.width) * canvas.width;
        const clickY = ((touch.clientY - rect.top) / rect.height) * canvas.height;
        handleGridClick(Math.floor(clickX / TILE_SIZE), Math.floor(clickY / TILE_SIZE));
    });

    canvas.addEventListener('click', (e) => {
        const rect = canvas.getBoundingClientRect();
        const clickX = ((e.clientX - rect.left) / rect.width) * canvas.width;
        const clickY = ((e.clientY - rect.top) / rect.height) * canvas.height;
        handleGridClick(Math.floor(clickX / TILE_SIZE), Math.floor(clickY / TILE_SIZE));
    });

    function handleGridClick(gX, gY) {
        if (gX >= COLS || gY >= ROWS) return;

        if (selectedShopType) {
            const spec = TOWER_TYPES[selectedShopType];
            const onPath = gridPath.some(p => p.x === gX && p.y === gY);
            const hasTower = towers.some(t => t.gridX === gX && t.gridY === gY);
            
            if (!onPath && !hasTower && gold >= spec.cost) {
                gold -= spec.cost;
                towers.push({
                    gridX: gX, gridY: gY, x: gX * TILE_SIZE + TILE_SIZE/2, y: gY * TILE_SIZE + TILE_SIZE/2,
                    type: selectedShopType, level: 1, damage: spec.damage, range: spec.range,
                    fireRate: spec.fireRate, color: spec.color, totalValue: spec.cost, cooldown: 0
                });
                selectedShopType = null;
                Object.keys(TOWER_TYPES).forEach(k => document.getElementById(`shop-${k}`).classList.remove('active'));
                updateHUD();
            }
        } else {
            const clicked = towers.find(t => t.gridX === gX && t.gridY === gY);
            if (clicked) { selectedTower = clicked; inspectUnit(clicked); } 
            else { selectedTower = null; document.getElementById('inspect-panel').style.display = 'none'; }
        }
    }

    function inspectUnit(tower) {
        document.getElementById('inspect-panel').style.display = 'flex';
        const upCost = Math.floor(tower.totalValue * 0.8);
        document.getElementById('inspect-stats').innerHTML = `<strong>⚡ ${TOWER_TYPES[tower.type].name} (Lv ${tower.level})</strong> | Dmg: ${tower.damage} | Rng: ${tower.range}`;
        document.getElementById('upgrade-cost').innerText = tower.level >= 3 ? "MAX" : `💰${upCost}`;
        document.getElementById('upgrade-btn').disabled = tower.level >= 3 || gold < upCost;
        document.getElementById('upgrade-btn').onclick = () => {
            if (gold >= upCost && tower.level < 3) {
                gold -= upCost; tower.level++; tower.damage = Math.floor(tower.damage * 1.6);
                tower.range = Math.floor(tower.range * 1.2); tower.totalValue += upCost; updateHUD();
            }
        };
        const refund = Math.floor(tower.totalValue * 0.75);
        document.getElementById('sell-refund').innerText = `💰+${refund}`;
        document.getElementById('sell-btn').onclick = () => {
            gold += refund; towers = towers.filter(t => t !== tower);
            selectedTower = null; document.getElementById('inspect-panel').style.display = 'none'; updateHUD();
        };
    }

    document.getElementById('wave-btn').onclick = () => {
        if (waveActive) return;
        wave++; waveActive = true; updateHUD();
        const isBoss = wave % 10 === 0;
        let count = isBoss ? 1 : 5 + wave * 2;
        let hp = isBoss ? wave * 400 : wave * 25 + 15;
        let speed = isBoss ? 0.5 : 1.0 + (wave * 0.04);
        let spawned = 0;
